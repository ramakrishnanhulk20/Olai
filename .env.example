# Copy this file to .env and fill in the blanks. Never commit .env.

# Olai's brain. Create a key at console.anthropic.com, Settings, API keys.
ANTHROPIC_API_KEY=

# The password to Olai's own API. Invent one, keep it secret, start it with
# "ol." and make it at least 24 characters. Anyone holding it can approve trades.
OLAI_OWNER_TOKEN=ol.

# Port the local Olai service listens on.
OLAI_PORT=4000

# Where the SQLite audit ledger file is written, relative to packages/agent.
OLAI_DB_PATH=./data/olai.db

# Where the rulebook Olai trades under is stored, relative to packages/agent.
# Edit it through the dashboard, not by hand: the ledger records every version.
OLAI_RULEBOOK_PATH=./data/rulebook.json

# The one browser address allowed to call Olai's API. Change it when the
# dashboard is deployed somewhere other than the local dev server.
OLAI_WEB_ORIGIN=http://localhost:3000

# Only true when a proxy in front of Olai sets X-Forwarded-For itself. Leave it
# false when running locally, or anyone could dodge the rate limit with a header.
OLAI_TRUST_PROXY=false

# Which door to Binance. auto picks rest when BINANCE_API_KEY and BINANCE_API_SECRET are
# set, else mcp when a stored MCP token exists, else fake (dry run only). rest, mcp and fake
# force one door; live mode refuses to boot on fake.
OLAI_EXCHANGE=auto

# Binance API key for the Spot REST API. For practice: sign in at
# https://testnet.binance.vision with GitHub and generate an HMAC key, which
# spends nothing real. For live: make a sub-account, give its key Enable Spot
# Trading only, leave withdrawals off, and restrict it to this machine's IP.
BINANCE_API_KEY=

# The secret shown once when the key is created. Binance never shows it again.
# Olai only ever uses it to sign a request, and never writes it to a log.
BINANCE_API_SECRET=

# Which Binance the key belongs to: testnet for practice money, prod for real
# money. Leave it on testnet until a full dry run has been read line by line.
BINANCE_API_ENV=testnet

# true means Olai plans trades and payments but never sends them. Set to false
# only for a live run, and only after a dry run of the same session.
OLAI_DRY_RUN=true

# Binance's hosted MCP server. Fixed address from the Agent OS docs, change only
# if Binance publishes a new one.
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic

# The address Binance can reach Olai on. Binance downloads Olai's client
# metadata document from this address during the sign-in step, so it must be a
# public HTTPS address. In development run a tunnel (for example
# "npx cloudflared tunnel --url http://127.0.0.1:4000") and paste its URL here.
OLAI_PUBLIC_BASE_URL=http://127.0.0.1:4000

# Where the Binance sign-in token is stored, relative to packages/agent. The file
# is written owner-only. Keep it out of git and never share it.
OLAI_TOKEN_PATH=./data/binance-mcp-token.json

# The name shown to you on the Binance consent screen when you approve access.
OLAI_CLIENT_NAME=Olai

# Base address of the B402 Bazaar, where Olai discovers and pays data merchants.
BAZAAR_BASE_URL=https://www.binance.com/bapi/ramp/v1/public/ramp/b402

# Only "yes" lets npm run prove spend real money on one paid data call, and only
# when OLAI_DRY_RUN is false as well. Anything else and it prints what it would
# have paid and skips the payment.
OLAI_PROVE_SPEND=no
